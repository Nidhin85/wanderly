      </div>

      <div>
        <h3>Contact Us</h3>
        <ul>
          <li>12 Marine Drive, Kochi, Kerala 682031</li>
          <li><a href="tel:+919876543210">+91 98765 43210</a></li>
          <li><a href="mailto:hello@wanderly.example">hello@wanderly.example</a></li>
        </ul>
      </div>
    </div>

    <p class="copyright">© {year} Wanderly. All rights reserved. (Fictional company for demo purposes.)</p>
  </div>
</footer>